const SS = SpreadsheetApp.getActiveSpreadsheet();

function doPost(e) {
  const sheet = SS.getSheetByName("Notas") || SS.getSheets()[0];
  const data = JSON.parse(e.postData.contents);
  const action = data.action || "save_note";
  const rows = sheet.getDataRange().getValues();
  
  const id = String(data.id);
  let rowIndex = -1;

  // 1. Procura o ID na primeira coluna
  for (let i = 1; i < rows.length; i++) {
    if (String(rows[i][0]) === id) {
      rowIndex = i + 1;
      break;
    }
  }

  // Lógica para EXCLUIR
  if (action === "delete") {
    if (rowIndex > -1) {
      sheet.deleteRow(rowIndex);
      return responseJSON({ status: "deleted", id });
    }
    return responseJSON({ status: "not_found", id });
  }

  // Lógica para SALVAR (Cria ou Atualiza)
  // Ordem das Colunas: ID (A), DATA (B), TITULO (C), CONTEUDO (D), CLIENTE_ID (E), CLIENTE_NOME (F)
  const rowData = [
    id,
    data.data || new Date().toISOString(),
    data.title || "Sem Título",
    data.content || "",
    data.clienteId || "",
    data.clienteNome || ""
  ];

  if (rowIndex > -1) {
    // UPDATE: Atualiza a linha existente
    sheet.getRange(rowIndex, 1, 1, rowData.length).setValues([rowData]);
    return responseJSON({ status: "updated", id });
  } else {
    // CREATE: Adiciona nova linha
    sheet.appendRow(rowData);
    return responseJSON({ status: "created", id });
  }
}

function doGet() {
  const sheet = SS.getSheetByName("Notas") || SS.getSheets()[0];
  const rows = sheet.getDataRange().getValues();
  
  if (rows.length <= 1) return responseJSON([]);

  const result = rows.slice(1).map(row => ({
    id: row[0],
    data: row[1],
    title: row[2],
    content: row[3],
    clienteId: row[4],
    clienteNome: row[5]
  }));

  return responseJSON(result);
}

// Helper para padronizar a resposta
function responseJSON(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
